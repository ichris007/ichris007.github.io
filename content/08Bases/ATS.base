      - property: status
        direction: ASC
      - property: pp_progress
        direction: DESC
      - property: formula.prog
        direction: ASC
      - property: formula.sortByDDL
        direction: ASC
      - property: formula.TillDDL
        direction: ASC
      - property: progress
        direction: DESC
    columnSize:
      formula.stars: 108
      note.status: 77
      formula.titleLink: 173
      note.Deadline: 118
      formula.statusOfDDL: 137
      formula.sortByDDL: 123
