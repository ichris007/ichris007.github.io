    sort:
      - property: formula.stars
        direction: DESC
      - property: status
        direction: ASC
      - property: pp_progress
        direction: DESC
      - property: formula.prog
        direction: ASC
      - property: formula.sortByDDL
        direction: ASC
      - property: formula.TillDDL
        direction: ASC
      - property: progress
