        direction: DESC
      - property: status
        direction: ASC
      - property: pp_progress
        direction: DESC
      - property: formula.prog
        direction: ASC
      - property: formula.sortByDDL
        direction: ASC
      - property: formula.TillDDL
        direction: ASC
      - property: progress
        direction: DESC
    columnSize:
      formula.stars: 108
      note.status: 77
      formula.pp_progress: 52
      note.client: 104
      formula.titleLink: 173
  - type: table
    name: Projects_Expiring Soon
    filters:
      or:
        - and:
            - file.tags.contains("Project")
            - category.contains("猎头")
            - area.containsAny("商业", "工作")
