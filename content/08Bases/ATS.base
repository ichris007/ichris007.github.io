  - type: table
    name: Clients_All
    filters:
      and:
        - area.containsAny("商业", "工作")
        - category.contains("猎头客户")
    order:
      - file.name
      - status
      - domain
      - start_date
      - stop_date
    sort:
      - property: file.name
        direction: ASC
      - property: created date
        direction: ASC
    limit: 15
    columnSize:
      file.name: 223
      note.status: 77
  - type: table
    name: Clients_ongong
    filters:
      and:
        - area.containsAny("商业", "工作")
        - category.contains("猎头客户")
