formulas:
  prog_percent: if(tasks > 0, ((tasks_completed / tasks) * 100).toFixed(0) + "%", "0%")
  prog_text: if(formula.prog_percent > 0, (formula.prog_percent * 100).round(), "0") + "%"
  prog_bar: if(formula.prog_percent * 10 > 0, "▰".repeat (number(formula.prog_percent * 10))) + if((formula.prog_percent * 10).floor() < 10, "▱▱▱▱▱▱▱▱▱▱".slice( 0, 10 - (formula.prog_percent * 10).floor()), "").toString()
  lucide-icon: if(status=="进行中", "arrow-right".icon(), if(status=="Focus", "flame".icon(), if(status=="On Hold", "pause".icon(), "")))
  prog: formula.prog_bar
  dead_icon: if(date(deadline) < today(), "skull".icon(), "")
  titleLink: link(file, if(title, title, file.basename))
  TillDDL: number((date(Deadline)-today()).days)
  statusOfDDL: |-
    if(formula["TillDDL"].isEmpty(),"❔ None", 
    if(formula["TillDDL"]>= 15, "🟠 Long Term", 
    if(formula["TillDDL"] < 1 && formula["TillDDL"] >= 0, "🛑 Due Today", 
      (
       if(formula["TillDDL"]< 0, "🔴 Overdue ",
       if(formula["TillDDL"]<= 5, "🟡 Only ", "🟢 Still "))
      ) + (date(deadline)-today())
    )))
  statusAsEmoji: |-
    if(status=="进行中", "▶️", 
    if(status=="未开始", "🚩", 
    if(status=="已停止", "❌", 
    if(status=="done", "📚", ""
    ))))
  titleAsLink: link(file, if(icon, icon+" ", "")+title)
  stars: |-
    if(stars=="5星级", "⭐⭐⭐⭐⭐",
    if(stars=="4星级", "⭐⭐⭐⭐☆",
    if(stars=="3星级", "⭐⭐⭐☆☆",
    if(stars=="2星级", "⭐⭐☆☆☆",
    if(stars=="1星级", "⭐☆☆☆☆", "")))))
  sortByDDL: if(formula["TillDDL"].isEmpty(),"5-❔ None", if(formula["TillDDL"]>= 15, "3-🟠 Long Term", if(formula["TillDDL"] <= 3 && formula["TillDDL"] >= 0, "2-🟡 Near ", (if(formula["TillDDL"]< 0, "0-🔴 Overdue ", if(formula["TillDDL"]<= 7, "2-🟡 Near ", "4-🟢 Easy "))) )))
  embededImage: file.embeds[0]
  pp_progress: if(tasks, if(tasks_completed, tasks_completed, 0) + "/" + tasks, " ")
  Priortity: |-
    if(stars=="5星级", "⭐⭐⭐⭐⭐",
    if(stars=="4星级", "⭐⭐⭐⭐☆",
    if(stars=="3星级", "⭐⭐⭐☆☆",
    if(stars=="2星级", "⭐⭐☆☆☆",
    if(stars=="1星级", "⭐☆☆☆☆", "")))))
properties:
  formula.prog_text:
    displayName: prog_text
  formula.prog_percent:
    displayName: prog%
  formula.lucide-icon:
    displayName: Icon
  file.name:
    displayName: name
  property.type:
    displayName: type
  property.icon:
    displayName: icon
  property.deadline:
    displayName: 死线
  formula.prog:
    displayName: progress
  note.status:
    displayName: status
  formula.titleLink:
    displayName: project
  note.deadline:
    displayName: DDL
  note.progress:
    displayName: ​prog
  note.icon:
    displayName: " "
  formula.titleAsLink:
    displayName: project
  formula.embededImage:
    displayName: embeds
  formula.pp_progress:
    displayName: Progress
  note.tasks:
    displayName: Tasks
  note.tasks_todo:
    displayName: Todo
  formula.stars:
    displayName: Priority
views:
  - type: table
    name: Projects_All
    filters:
      or:
        - and:
            - file.tags.contains("Project")
            - category.contains("猎头")
            - area.containsAny("商业", "工作")
    order:
      - formula.stars
      - status
      - formula.pp_progress
      - formula.prog_percent
      - client
      - formula.titleLink
      - Deadline
      - formula.statusOfDDL
      - formula.sortByDDL
    sort:
      - property: formula.stars
        direction: DESC
      - property: status
        direction: ASC
      - property: pp_progress
        direction: DESC
      - property: formula.prog
        direction: ASC
      - property: formula.sortByDDL
        direction: ASC
      - property: formula.TillDDL
        direction: ASC
      - property: progress
        direction: DESC
    columnSize:
      formula.stars: 108
      note.status: 77
      formula.titleLink: 173
      note.Deadline: 118
      formula.statusOfDDL: 137
      formula.sortByDDL: 123
  - type: table
    name: Projects_Ongoing
    filters:
      or:
        - and:
            - file.tags.contains("Project")
            - category.contains("猎头")
            - area.containsAny("商业", "工作")
            - status.contains("进行中")
    order:
      - formula.stars
      - formula.pp_progress
      - formula.prog_percent
      - client
      - formula.titleLink
    sort:
